<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SUPER AI Defense Shield & Auto-Tracer</title>
<style>
  :root {
    --bg-color: #0a0d14;
    --card-bg: #121824;
    --accent-cyan: #00f0ff;
    --accent-red: #ff2a5f;
    --accent-green: #00ff88;
    --text-main: #e2e8f0;
    --text-dim: #94a3b8;
    --border: #1e293b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  body { background-color: var(--bg-color); color: var(--text-main); padding: 15px; }

  .shield-container {
    max-width: 900px;
    margin: 0 auto;
    background: var(--card-bg);
    border: 1px solid var(--accent-cyan);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 15px;
    margin-bottom: 20px;
  }

  .brand { font-size: 1.3rem; font-weight: bold; color: var(--accent-cyan); letter-spacing: 1px; }
  .status-badge {
    background: rgba(0, 255, 136, 0.1);
    color: var(--accent-green);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    border: 1px solid var(--accent-green);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pulse-dot { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; box-shadow: 0 0 8px var(--accent-green); animation: pulse 1.5s infinite; }

  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px; }
  @media (max-width: 600px) { .grid-2 { grid-template-columns: 1fr; } }

  .stat-box { background: rgba(255,255,255,0.02); border: 1px solid var(--border); padding: 12px; border-radius: 8px; }
  .stat-label { font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; margin-bottom: 5px; }
  .stat-val { font-size: 0.95rem; font-weight: bold; color: var(--accent-cyan); }

  .scanner-section { margin-bottom: 20px; }
  .input-group { display: flex; gap: 10px; margin-top: 8px; }
  input[type="text"] {
    flex: 1;
    background: #07090e;
    border: 1px solid var(--border);
    padding: 10px 14px;
    border-radius: 6px;
    color: #fff;
    outline: none;
  }
  input[type="text"]:focus { border-color: var(--accent-cyan); }

  button {
    background: var(--accent-cyan);
    color: #000;
    font-weight: bold;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }
  button:hover { opacity: 0.9; box-shadow: 0 0 12px var(--accent-cyan); }
  button.danger { background: var(--accent-red); color: #fff; }
  button.danger:hover { box-shadow: 0 0 12px var(--accent-red); }

  .console-box {
    background: #05070a;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    height: 180px;
    overflow-y: auto;
    color: #00ff88;
    margin-bottom: 15px;
  }
  .log-entry { margin-bottom: 4px; line-height: 1.4; }
  .log-warn { color: #ffd700; }
  .log-danger { color: var(--accent-red); }

  .footer-bar { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-dim); border-top: 1px solid var(--border); padding-top: 12px; }
</style>
</head>
<body>

<div class="shield-container">
  <!-- Header -->
  <div class="header">
    <div class="brand">🛡️ SUPER AI DEFENSE AGENT</div>
    <div class="status-badge">
      <span class="pulse-dot"></span> SYSTEM PROTECTED
    </div>
  </div>

  <!-- Telemetry Grid -->
  <div class="grid-2">
    <div class="stat-box">
      <div class="stat-label">AI Processing Mode</div>
      <div class="stat-val">Local GPU / Dedicated Engine</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Perimeter Rule</div>
      <div class="stat-val">Zero-Trust & Auto Trace</div>
    </div>
  </div>

  <!-- Scanner Input -->
  <div class="scanner-section">
    <div class="stat-label">Target IP / Domain Quick Analysis & Auto Report</div>
    <div class="input-group">
      <input type="text" id="targetInput" placeholder="Enter untrusted IP or domain (e.g. 192.0.2.1 or mal-site.com)">
      <button onclick="runTrace()">Analyze & Trace</button>
    </div>
  </div>

  <!-- Telemetry Log Window -->
  <div class="console-box" id="consoleLogs">
    <div class="log-entry">[SYS INIT] Super AI Security Engine Online.</div>
    <div class="log-entry">[GUARD] Real-time perimeter active. Untrusted entries blocked.</div>
  </div>

  <!-- Action Controls -->
  <div style="display: flex; gap: 10px; margin-bottom: 15px;">
    <button class="danger" onclick="draftCyberReport()">Auto-Draft Incident Email</button>
  </div>

  <!-- Footer -->
  <div class="footer-bar">
    <span>VIPMAN AI Framework | Enterprise Edition</span>
    <span>Copyright © All Rights Reserved</span>
  </div>
</div>

<script>
  function log(msg, type = 'normal') {
    const consoleBox = document.getElementById('consoleLogs');
    const entry = document.createElement('div');
    entry.className = 'log-entry ' + (type === 'warn' ? 'log-warn' : type === 'danger' ? 'log-danger' : '');
    const timestamp = new Date().toLocaleTimeString();
    entry.innerText = `[${timestamp}] ${msg}`;
    consoleBox.appendChild(entry);
    consoleBox.scrollTop = consoleBox.scrollHeight;
  }

  function runTrace() {
    const target = document.getElementById('targetInput').value.trim();
    if (!target) {
      log('Error: Please enter a target IP address or domain.', 'warn');
      return;
    }

    log(`Initiating Super AI Scan on: ${target}...`);
    
    setTimeout(() => {
      log(`Step 1: Checking threat registries for ${target}...`, 'normal');
    }, 600);

    setTimeout(() => {
      log(`Step 2: Performing WHOIS & ASN route lookup...`, 'normal');
    }, 1200);

    setTimeout(() => {
      log(`[AI WARNING] Target ${target} shows unverified domain status & elevated risk score!`, 'danger');
      log(`Ready to trigger automated reporting workflow.`, 'warn');
    }, 1800);
  }

  function draftCyberReport() {
    const target = document.getElementById('targetInput').value.trim() || 'UNKNOWN_SUSPECT';
    const recipient = 'report@cybercrime.gov.in';
    const subject = encodeURIComponent(`URGENT: Suspicious Domain / IP Incident Report - ${target}`);
    const body = encodeURIComponent(
      `Cyber Security Incident Alert\n` +
      `----------------------------------------\n` +
      `Target IP / Domain: ${target}\n` +
      `Incident Status: Unverified / Malicious Indicator Flagged\n` +
      `Timestamp: ${new Date().toISOString()}\n\n` +
      `System Notes:\n` +
      `- Automated Super AI Defense Shield recorded untrusted connection attempt.\n` +
      `- Requesting IP trace, WHOIS audit, and network block evaluation.\n\n` +
      `Submitted automatically via AI Defense Suite.`
    );

    window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
    log(`Mail client triggered: Pre-filled incident report generated for ${recipient}.`, 'normal');
  }
</script>

</body>
</html>
